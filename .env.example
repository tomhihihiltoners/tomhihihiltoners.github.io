# Google Calendar — public OAuth client ID (a browser identifier, NOT a secret).
# Create it at https://console.cloud.google.com/apis/credentials as an
# "OAuth client ID" of type "Web application", enable the Google Calendar API,
# and add the origins that will host the dashboard:
#   https://dmitriicreativit.space   (the live custom domain)
#   https://tomhihihiltoners.github.io
#   http://localhost:5173
# The client secret is never used by this app and must never be committed.
VITE_GOOGLE_CLIENT_ID=

# Calendar to read: "primary" for the signed-in account, or any calendar id/email.
VITE_GOOGLE_CALENDAR_ID=primary

# Open-Meteo needs no key. These values are the fallback location used when the
# browser denies the geolocation prompt.
VITE_WEATHER_CITY=Москва
VITE_WEATHER_LAT=55.7558
VITE_WEATHER_LON=37.6173
